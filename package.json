{
  "name": "control-governor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file=.env.local node_modules/.bin/drizzle-kit generate",
    "db:push": "node --env-file=.env.local node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file=.env.local node_modules/.bin/drizzle-kit studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:backup": "bash scripts/backup-db.sh",
    "db:import": "node --env-file=.env.local node_modules/.bin/tsx scripts/import-backup.ts",
    "db:learning:generate": "node --env-file=.env.local node_modules/.bin/drizzle-kit generate --config=drizzle.learning.config.ts",
    "db:learning:push": "node --env-file=.env.local node_modules/.bin/drizzle-kit push --config=drizzle.learning.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.10",
    "officeparser": "^7.5.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
