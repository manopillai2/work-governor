"use client";

import { useEffect, useMemo, useState } from "react";

import ApplicationCard from "@/components/ApplicationCard";
import ChatPanel, {
  type ChatMessage,
} from "@/components/ChatPanel";
import ControlCard from "@/components/ControlCard";
import Header from "@/components/layout/Header";
import ProgressSummary from "@/components/ProgressSummary";

import {
  executeCommand,
  type Application,
  type Command,
} from "@/services/commandEngine";

const STORAGE_KEY = "work-governor-core-v4";

type AssistantApiResponse = {
  command?: Command;
  assistantMessage?: string;
  error?: string;
  usage?: {
    inputTokens: number;
    outputTokens: number;
  };
};

type StoredWorkGovernorData = {
  applications: Application[];
  messages: ChatMessage[];
};

function createMessage(
  role: ChatMessage["role"],
  content: string
): ChatMessage {
  return {
    id: `${role}-${Date.now()}-${Math.random()
      .toString(36)
      .slice(2, 8)}`,
    role,
    content,
  };
}

function normalizeStoredApplications(
  applications: Application[]
): Application[] {
  if (!Array.isArray(applications)) {
    return [];
  }

  return applications
    .filter(
      (application) =>
        application &&
        Boolean(application.id || application.name)
    )
    .map((application) => {
      const applicationId =
        application.id || application.name;

      const applicationName =
        application.name || application.id;

      return {
        ...application,
        id: applicationId,
        name: applicationName,
        hosting: application.hosting || "Unknown",

        controls: Array.isArray(application.controls)
          ? application.controls
              .filter(
                (control) =>
                  control && Boolean(control.name)
              )
              .map((control) => ({
                ...control,
                id:
                  control.id ||
                  `control-${Date.now()}-${Math.random()
                    .toString(36)
                    .slice(2, 8)}`,
                name: control.name,
                framework: control.framework || "SOX",
                homeworkStatus:
                  control.homeworkStatus || "Waiting",
                stage: control.stage || "Homework",
                notes: Array.isArray(control.notes)
                  ? control.notes
                  : [],
                nextTasks: Array.isArray(
                  control.nextTasks
                )
                  ? control.nextTasks
                  : [],
              }))
          : [],
      };
    });
}

export default function Home() {
  const [applications, setApplications] = useState<
    Application[]
  >([]);

  const [messages, setMessages] = useState<
    ChatMessage[]
  >([]);

  const [
    expandedApplication,
    setExpandedApplication,
  ] = useState<string | null>(null);

  const [isProcessing, setIsProcessing] =
    useState(false);

  const [isLoaded, setIsLoaded] = useState(false);

  useEffect(() => {
    try {
      const savedData =
        localStorage.getItem(STORAGE_KEY);

      if (savedData) {
        const parsedData = JSON.parse(
          savedData
        ) as StoredWorkGovernorData;

        setApplications(
          normalizeStoredApplications(
            Array.isArray(parsedData.applications)
              ? parsedData.applications
              : []
          )
        );

        setMessages(
          Array.isArray(parsedData.messages)
            ? parsedData.messages
            : []
        );

        return;
      }

      const previousKeys = [
        "work-governor-core-v3",
        "work-governor-core-v2",
        "work-governor-core-v1",
      ];

      for (const previousKey of previousKeys) {
        const previousData =
          localStorage.getItem(previousKey);

        if (!previousData) {
          continue;
        }

        const parsedPreviousData = JSON.parse(
          previousData
        ) as StoredWorkGovernorData | Application[];

        if (Array.isArray(parsedPreviousData)) {
          setApplications(
            normalizeStoredApplications(
              parsedPreviousData
            )
          );

          setMessages([]);
        } else {
          setApplications(
            normalizeStoredApplications(
              parsedPreviousData.applications || []
            )
          );

          setMessages(
            Array.isArray(
              parsedPreviousData.messages
            )
              ? parsedPreviousData.messages
              : []
          );
        }

        break;
      }
    } catch (error) {
      console.error(
        "Unable to restore Work Governor data:",
        error
      );

      setApplications([]);
      setMessages([]);
    } finally {
      setIsLoaded(true);
    }
  }, []);

  useEffect(() => {
    if (!isLoaded) {
      return;
    }

    const dataToStore: StoredWorkGovernorData = {
      applications,
      messages,
    };

    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(dataToStore)
    );
  }, [applications, messages, isLoaded]);

  const progress = useMemo(() => {
    const controls = applications.flatMap(
      (application) => application.controls
    );

    return {
      applications: applications.length,
      controls: controls.length,

      completed: controls.filter(
        (control) =>
          control.homeworkStatus === "Completed" ||
          control.stage === "Completed"
      ).length,

      waiting: controls.filter(
        (control) =>
          control.homeworkStatus === "Waiting"
      ).length,
    };
  }, [applications]);

  async function handleSend(userInput: string) {
    if (typeof userInput !== "string") {
      console.error(
        "ChatPanel returned a non-string value:",
        userInput
      );
      return;
    }

    const trimmedInput = userInput.trim();

    if (!trimmedInput || isProcessing) {
      return;
    }

    const userMessage = createMessage(
      "user",
      trimmedInput
    );

    const historyBeforeRequest =
      messages.slice(-10);

    setMessages((currentMessages) => [
      ...currentMessages,
      userMessage,
    ]);

    setIsProcessing(true);

    try {
      const response = await fetch(
        "/api/assistant",
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
          },

          body: JSON.stringify({
            message: trimmedInput,
            applications,

            history: historyBeforeRequest.map(
              (message) => ({
                role: message.role,
                content: message.content,
              })
            ),
          }),
        }
      );

      const data =
        (await response.json()) as AssistantApiResponse;

      if (!response.ok) {
        throw new Error(
          data.error ||
            "The assistant request failed."
        );
      }

      if (!data.command) {
        throw new Error(
          "The assistant did not return a valid command."
        );
      }

      const result = executeCommand(
        data.command,
        applications
      );

      setApplications(result.applications);

      setMessages((currentMessages) => [
        ...currentMessages,
        createMessage(
          "assistant",
          result.message ||
            data.assistantMessage ||
            "The Work Governor request was completed."
        ),
      ]);

      if (
        data.command.action !== "RESPOND_ONLY" &&
        data.command.action !==
          "DELETE_ALL_APPLICATIONS"
      ) {
        const applicationName =
          "application" in data.command.payload
            ? data.command.payload.application
            : undefined;

        if (applicationName) {
          const digits =
            applicationName.match(/\d+/)?.[0];

          const normalizedApplication = digits
            ? `APP-${digits.padStart(2, "0")}`
            : applicationName.toUpperCase();

          setExpandedApplication(
            normalizedApplication
          );
        }
      }

      if (
        data.command.action ===
        "DELETE_ALL_APPLICATIONS"
      ) {
        setExpandedApplication(null);
      }
    } catch (error) {
      console.error(
        "Work Governor request failed:",
        error
      );

      const errorMessage =
        error instanceof Error
          ? error.message
          : "The assistant request failed.";

      setMessages((currentMessages) => [
        ...currentMessages,
        createMessage(
          "assistant",
          errorMessage
        ),
      ]);
    } finally {
      setIsProcessing(false);
    }
  }

  function toggleApplication(
    applicationId: string
  ) {
    setExpandedApplication(
      (currentApplication) =>
        currentApplication === applicationId
          ? null
          : applicationId
    );
  }

  if (!isLoaded) {
    return (
      <main className="min-h-screen bg-slate-950 text-slate-100">
        <Header />

        <div className="mx-auto w-full max-w-[1900px] px-4 py-8 xl:px-6">
          <p className="text-sm text-slate-400">
            Loading Work Governor...
          </p>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-950 text-slate-100">
      <Header />

      <div className="mx-auto w-full max-w-[1900px] px-4 py-5 xl:px-6">
  <div className="grid min-h-[calc(100vh-135px)] items-stretch gap-5 xl:grid-cols-[18fr_52fr_30fr]">    
      {/* 18% — Progress Summary */}
          <section className="min-w-0">
            <ProgressSummary
              applications={progress.applications}
              controls={progress.controls}
              completed={progress.completed}
              waiting={progress.waiting}
            />
          </section>

          {/* 52% — Applications */}
          <section className="min-w-0">
            <div className="mb-4 flex items-end justify-between gap-4">
              <div>
                <h2 className="text-xl font-semibold text-white">
                  Applications
                </h2>

                <p className="mt-1 text-sm text-slate-400">
                  Track controls, evidence discovery,
                  progress, and Argos readiness.
                </p>
              </div>

              <span className="shrink-0 rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs font-medium text-slate-300">
                {applications.length} application
                {applications.length === 1 ? "" : "s"}
              </span>
            </div>

            {applications.length === 0 ? (
              <div className="flex min-h-[260px] items-center justify-center rounded-xl border border-dashed border-slate-700 bg-slate-900/50 p-8 text-center">
                <div>
                  <h3 className="text-base font-medium text-slate-200">
                    No applications yet
                  </h3>

                  <p className="mt-2 text-sm text-slate-400">
                    Use the Work Governor chat to create
                    an application and its controls.
                  </p>
                </div>
              </div>
            ) : (
              <div className="max-h-[calc(100vh-185px)] space-y-4 overflow-y-auto pr-2">
                {applications.map(
                  (application) => (
                    <ApplicationCard
                      key={application.id}
                      applicationName={
                        application.name
                      }
                      hosting={
                        application.hosting
                      }
                      totalControls={
                        application.controls.length
                      }
                      expanded={
                        expandedApplication ===
                        application.id
                      }
                      onToggle={() =>
                        toggleApplication(
                          application.id
                        )
                      }
                    >
                      {application.controls.length ===
                      0 ? (
                        <p className="text-sm text-slate-500">
                          No controls have been added.
                        </p>
                      ) : (
                        <div className="grid gap-4 2xl:grid-cols-2">
                          {application.controls.map(
                            (control) => (
                              <ControlCard
                                key={control.id}
                                controlName={
                                  control.name
                                }
                                framework={
                                  control.framework
                                }
                                homeworkStatus={
                                  control.homeworkStatus
                                }
                                stage={
                                  control.stage
                                }
                                notes={
                                  control.notes || []
                                }
                                nextTasks={
                                  control.nextTasks || []
                                }
                              />
                            )
                          )}
                        </div>
                      )}
                    </ApplicationCard>
                  )
                )}
              </div>
            )}
          </section>

          {/* 30% — Chat */}
          <aside className="min-w-0 h-full">  
	  <ChatPanel
              messages={messages}
              onSend={handleSend}
              assistantMessage={
                isProcessing
                  ? "Work Governor is reviewing the current application data and conversation..."
                  : undefined
              }
            />
          </aside>
        </div>
      </div>
    </main>
  );
}
