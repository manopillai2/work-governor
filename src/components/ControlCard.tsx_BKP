"use client";

// ======================================================
// Component Name : ControlCard
// Purpose        : Displays control status, notes,
//                  workflow stage, and next tasks
// Author         : Manoj
// ======================================================

import { useState } from "react";

import {
  HomeworkStatus,
  WorkflowStage,
} from "@/services/commandEngine";

type ControlCardProps = {
  controlName: string;
  framework: string;
  homeworkStatus: HomeworkStatus;
  stage?: WorkflowStage;
  notes?: string[];
  nextTasks?: string[];
};

export default function ControlCard({
  controlName,
  framework,
  homeworkStatus,
  stage = "Homework",
  notes = [],
  nextTasks = [],
}: ControlCardProps) {
  const [expanded, setExpanded] = useState(false);

  function handleToggle() {
    setExpanded((currentValue) => !currentValue);
  }

  return (
    <div className="overflow-hidden rounded-xl border border-slate-200 bg-white">
      <button
        type="button"
        onClick={handleToggle}
        aria-expanded={expanded}
        className="flex w-full items-center justify-between gap-4 p-4 text-left transition hover:bg-slate-50"
      >
        <div className="min-w-0">
          <h4 className="truncate font-semibold text-slate-900">
            {controlName}
          </h4>

          <div className="mt-2 flex flex-wrap gap-2">
            <span className="rounded-full bg-purple-100 px-3 py-1 text-xs font-medium text-purple-700">
              {framework}
            </span>

            <StageBadge stage={stage} />
          </div>
        </div>

        <div className="flex shrink-0 items-center gap-3">
          <HomeworkBadge status={homeworkStatus} />

          <span
            className="flex h-7 w-7 items-center justify-center rounded-full border border-slate-300 text-lg text-slate-500"
            aria-hidden="true"
          >
            {expanded ? "−" : "+"}
          </span>
        </div>
      </button>

      {expanded && (
        <div className="space-y-4 border-t border-slate-200 p-4">
          <section className="rounded-xl bg-amber-50 p-4">
            <h5 className="font-medium text-amber-900">
              Homework
            </h5>

            {homeworkStatus === "Completed" ? (
              <p className="mt-2 text-sm leading-6 text-amber-800">
                Homework has been completed. Review the notes
                and proceed with the suggested next tasks.
              </p>
            ) : (
              <p className="mt-2 text-sm leading-6 text-amber-800">
                Connect with the application team to understand
                the application purpose, hosting, deployment,
                ownership, access model, identities, and logging
                requirements.
              </p>
            )}
          </section>

          <section className="rounded-xl border border-slate-200 p-4">
            <h5 className="font-medium text-slate-900">
              Current Stage
            </h5>

            <p className="mt-2 text-sm text-slate-600">
              {stage}
            </p>
          </section>

          <section className="rounded-xl border border-slate-200 p-4">
            <h5 className="font-medium text-slate-900">
              Work Notes
            </h5>

            {notes.length === 0 ? (
              <p className="mt-2 text-sm text-slate-500">
                No notes have been recorded.
              </p>
            ) : (
              <div className="mt-3 space-y-3">
                {notes.map((note, index) => (
                  <div
                    key={`${note}-${index}`}
                    className="rounded-lg bg-slate-50 p-3 text-sm leading-6 text-slate-700"
                  >
                    {note}
                  </div>
                ))}
              </div>
            )}
          </section>

          <section className="rounded-xl border border-slate-200 p-4">
            <h5 className="font-medium text-slate-900">
              Suggested Next Tasks
            </h5>

            {nextTasks.length === 0 ? (
              <p className="mt-2 text-sm text-slate-500">
                Complete the homework to generate suggested
                next tasks.
              </p>
            ) : (
              <div className="mt-3 space-y-2">
                {nextTasks.map((task, index) => (
                  <label
                    key={`${task}-${index}`}
                    className="flex items-start gap-3 rounded-lg bg-slate-50 p-3"
                  >
                    <input
                      type="checkbox"
                      className="mt-1 h-4 w-4 rounded border-slate-300"
                    />

                    <span className="text-sm leading-6 text-slate-700">
                      {task}
                    </span>
                  </label>
                ))}
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  );
}

function HomeworkBadge({
  status,
}: {
  status: HomeworkStatus;
}) {
  const completed = status === "Completed";

  return (
    <span
      className={`rounded-full px-3 py-1 text-xs font-medium ${
        completed
          ? "bg-green-100 text-green-700"
          : "bg-amber-100 text-amber-700"
      }`}
    >
      Homework {status}
    </span>
  );
}

function StageBadge({
  stage,
}: {
  stage: WorkflowStage;
}) {
  return (
    <span className="rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">
      Stage: {stage}
    </span>
  );
}
